# ============================================
# ExtraHand Task Service - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env file to version control!

# ============================================
# Application Configuration
# ============================================
NODE_ENV=development
PORT=4002

# ============================================
# MongoDB Configuration
# ============================================
# MongoDB connection string
# Format: mongodb://[username:password@]host[:port][/database][?options]
# Examples:
#   - Local: mongodb://localhost:27017
#   - Atlas: mongodb+srv://username:password@cluster.mongodb.net
#   - With DB: mongodb://localhost:27017/extrahand
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=extrahand

# ============================================
# Redis (optional - task list cache)
# ============================================
# Use the Redis protocol, not https. Same host as dashboard, port 6379.
# Format: redis://:password@host:6379  or  rediss://:password@host:6379 (TLS)
# Example for extrahand-redis.apps.extrahand.in (set REDIS_PASSWORD in .env, never commit):
# REDIS_URL=redis://:YOUR_REDIS_PASSWORD@extrahand-redis.apps.extrahand.in:6379
# If your Redis requires TLS (e.g. public URL), use rediss://:
# REDIS_URL=rediss://:YOUR_REDIS_PASSWORD@extrahand-redis.apps.extrahand.in:6379

# ============================================
# Firebase Configuration
# ============================================
# Option 1: Use serviceAccountKey.json file (RECOMMENDED for local development)
# Place serviceAccountKey.json in the service root directory (extrahand-task-service/)
# No additional env vars needed if using this method

# Option 2: Use environment variables (for production/docker)
# Uncomment and fill these if not using serviceAccountKey.json file:
# FIREBASE_PROJECT_ID=extrahand-app
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@extrahand-app.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Option 3: Use custom path to service account file
# FIREBASE_SERVICE_ACCOUNT_PATH=/path/to/serviceAccountKey.json

# Option 4: Use Google Application Default Credentials
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/serviceAccountKey.json

# Firebase Web API Key (for login endpoint - if needed)
# Get from Firebase Console > Project Settings > General > Web API Key
# FIREBASE_WEB_API_KEY=your-firebase-web-api-key

# Firebase Auth Emulator (for local testing)
# Uncomment if using Firebase Auth Emulator:
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# ============================================
# Service-to-Service Communication
# ============================================
# Shared secret token for inter-service authentication
# MUST be the same across all services
# Generate a strong random token: openssl rand -hex 32
SERVICE_AUTH_TOKEN=your-shared-secret-token-here

# Other service URLs (for inter-service calls)
USER_SERVICE_URL=http://localhost:4001
EMAIL_SERVICE_URL=http://localhost:4007
CHAT_SERVICE_URL=http://localhost:4003
MESSAGING_SERVICE_URL=http://localhost:4006
PAYMENT_SERVICE_URL=http://localhost:4003

# ============================================
# Storage Configuration
# ============================================
# Storage provider: 'local', 'minio', or 's3'
# - local: Saves files to disk (perfect for development, no external service needed)
# - minio: MinIO object storage (for CapRover deployment or self-hosted)
# - s3: AWS S3 (for production with AWS)
STORAGE_PROVIDER=local

# Local File Storage (for development)
# Saves files to local disk - simplest option for development
# LOCAL_STORAGE_DIR=uploads
# LOCAL_STORAGE_URL=http://localhost:4002/uploads

# MinIO Configuration (for local development or CapRover)
MINIO_ENDPOINT=localhost
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
# Alternative naming (CapRover uses these):
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=extrahand-images
MINIO_PUBLIC_DOMAIN=http://localhost:9000
# For CapRover deployment:
# MINIO_SERVER_URL=https://your-minio-domain.com
# MINIO_REGION_NAME=us-east-1

# AWS S3 Configuration (alternative to MinIO)
# Uncomment if using AWS S3 instead of MinIO:
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_S3_BUCKET_NAME=extrahand-images
# AWS_CLOUDFRONT_DOMAIN=https://your-cloudfront-domain.com

# ============================================
# Security & Rate Limiting
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# ============================================
# CORS Configuration
# ============================================
# Comma-separated list of allowed origins
# Default origins are already included (localhost:3000, localhost:4000, etc.)
# Add production domains here:
# CORS_ORIGIN=https://extrahand.in,https://www.extrahand.in

# ============================================
# Logging
# ============================================
LOG_LEVEL=info
# Options: error, warn, info, debug

# ============================================
# Health Check
# ============================================
HEALTH_CHECK_PATH=/api/v1/health
