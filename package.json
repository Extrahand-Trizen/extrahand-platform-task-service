{
  "name": "extrahand-task-service",
  "version": "1.0.0",
  "description": "Task Service for ExtraHand Platform - Handles tasks, applications, reviews, and task-related operations",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs');const p='dist/data';fs.mkdirSync(p,{recursive:true});fs.copyFileSync('src/data/book-now-catalog-seed-data.json',p+'/book-now-catalog-seed-data.json');\"",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "prod": "NODE_ENV=production node dist/server.js",
    "test": "ts-node src/tests/recurringVisitBuffer.test.ts",
    "test:recurring": "ts-node src/tests/recurringVisitBuffer.test.ts",
    "assign:book-now-ac-diagnosis": "ts-node src/scripts/assignBookNowAcDiagnosisTask.ts",
    "create:book-now-application": "ts-node src/scripts/createBookNowAcceptedApplication.ts",
    "simulate:helper-journey": "ts-node src/scripts/simulateHelperJourneyProgress.ts",
    "fetch:dev-user-applications": "ts-node src/scripts/fetchDevUserApplications.ts",
    "backfill:recurring-visits": "ts-node src/scripts/backfillRecurringVisits.ts",
    "validate:recurring-visits": "ts-node src/scripts/validateRecurringVisitMigration.ts",
    "lint": "eslint src --ext .ts",
    "health": "curl -f http://localhost:4002/api/v1/health || exit 1"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@types/node-cron": "^3.0.11",
    "aws-sdk": "^2.1691.0",
    "axios": "^1.6.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.5",
    "firebase-admin": "^12.5.0",
    "helmet": "^7.1.0",
    "ioredis": "^5.9.3",
    "mongoose": "^8.8.0",
    "morgan": "^1.10.0",
    "multer": "^2.0.0",
    "node-cron": "^4.2.1",
    "redis": "^5.11.0",
    "redis-cli": "^2.1.2",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "winston": "^3.11.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.6",
    "@types/socket.io": "^3.0.1",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "nodemon": "^3.1.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
